# Copy to .env.local and fill in. .env.local is gitignored and must never be committed.
# Nothing in this pipeline falls back to a default key: a missing variable stops
# the run with a message naming it.

# Stage 2 -- the independent check. scripts/check-facts.mjs
ANTHROPIC_API_KEY=

# Stage 3 -- the final check, second vendor. scripts/check-facts-openai.mjs
OPENAI_API_KEY=

# The scripts read process.env directly and do not parse this file. Either export
# the variables in your shell, or source it:  set -a; . ./.env.local; set +a
